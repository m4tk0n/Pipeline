# Sdilena konfigurace projektu Pipeline. Sem NEVKLADAT zadne tokeny ani hesla.
# Citlive udaje GEMINI_API_KEY, FTP_SERVER, FTP_USERNAME a FTP_PASSWORD
# zustavaji v GitHub Actions Secrets.

GEMINI_MODEL=gemini-2.5-flash
MAX_TURNS=15
AGENT_TIMEOUT_SECONDS=600
TEST_TIMEOUT_SECONDS=45
FTP_REMOTE_DIR=pipeline
LIVE_UPDATE_INTERVAL_MS=2000
MAX_LOG_ENTRIES=250
MIN_TESCO_PRODUCTS=1
